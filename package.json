{
  "name": "handyfix",
  "private": true,
  "version": "1.0.0",
  "description": "HandyFix monorepo: Expo mobile app, web admin, shared logic, Supabase backend",
  "workspaces": [
    "apps/admin",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run mobile:typecheck",
    "legal:build": "node scripts/build-legal-site.mjs",
    "admin": "npm run dev -w @handyfix/admin",
    "legacy:customer": "npm --prefix legacy/customer-app run dev",
    "legacy:provider": "npm --prefix legacy/provider-app run dev",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:start": "npm --prefix apps/mobile run start",
    "web:customer": "npm --prefix apps/mobile run web:customer",
    "web:provider": "npm --prefix apps/mobile run web:provider",
    "start:customer": "npm --prefix apps/mobile run start:customer",
    "start:provider": "npm --prefix apps/mobile run start:provider",
    "env:check": "node scripts/env-doctor.mjs",
    "env:fix": "node scripts/env-doctor.mjs --fix"
  }
}
