{
  "projectType": "webapp",
  "devServer": {
    "command": "npm",
    "args": [
      "run",
      "dev",
      "--",
      "--host",
      "127.0.0.1",
      "--port",
      "3003",
      "--strictPort"
    ],
    "url": "http://127.0.0.1:3003/",
    "readyTimeoutSeconds": 120
  },
  "assertions": [
    {
      "name": "tsc-no-emit",
      "kind": "process",
      "command": "npx",
      "args": ["tsc", "--noEmit"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "provider-login-smoke",
      "kind": "playwright-route",
      "scriptPath": ".tsupgrader/runtime-validation/playwright-scripts/provider-login-smoke.spec.ts",
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 120
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    }
  ]
}
