{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "development"
    },
    "customer-dev": { "extends": "development", "env": { "EXPO_PUBLIC_APP_VARIANT": "customer" } },
    "provider-dev": { "extends": "development", "env": { "EXPO_PUBLIC_APP_VARIANT": "provider" } },
    "customer-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "customer" }
    },
    "provider-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "provider" }
    },
    "customer-production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "channel": "production",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "customer" }
    },
    "provider-production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "channel": "production",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "provider" }
    }
  },
  "submit": { "customer-production": {}, "provider-production": {} }
}
