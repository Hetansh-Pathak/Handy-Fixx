{
  "name": "@handyfix/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@handyfix/shared": "file:../../packages/shared",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-query": "^5.105.0",
    "aes-js": "^3.1.2",
    "expo": "~58.0.20",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.62.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-maps": "^1.29.11",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:e2e": "node e2e-web/serve.cjs",
    "web:customer": "cross-env EXPO_PUBLIC_APP_VARIANT=customer expo start --web --port 8081",
    "web:provider": "cross-env EXPO_PUBLIC_APP_VARIANT=provider expo start --web --port 8082",
    "start:customer": "cross-env EXPO_PUBLIC_APP_VARIANT=customer expo start --dev-client",
    "start:provider": "cross-env EXPO_PUBLIC_APP_VARIANT=provider expo start --dev-client",
    "start:staging": "node scripts/start-staging.cjs",
    "start:staging:customer": "node scripts/start-staging.cjs customer",
    "start:staging:provider": "node scripts/start-staging.cjs provider",
    "build:customer": "eas build --profile customer-dev --platform android",
    "build:provider": "eas build --profile provider-dev --platform android",
    "build:customer:preview": "eas build --profile customer-preview --platform android",
    "build:provider:preview": "eas build --profile provider-preview --platform android",
    "build:customer:release": "eas build --profile customer-production --platform android",
    "build:provider:release": "eas build --profile provider-production --platform android",
    "typecheck": "tsc --noEmit",
    "export:android": "EXPO_OFFLINE=1 expo export --platform android",
    "test:e2e-splash": "node e2e-web/splash-flow.cjs customer",
    "test:e2e-dispatch": "node e2e-web/dispatch-flow.cjs && node e2e-web/dispatch-pro-flow.cjs",
    "test:e2e-web": "node e2e-web/auth-flow.cjs && node e2e-web/booking-flow.cjs && node e2e-web/provider-flow.cjs && node e2e-web/status-flow.cjs && node e2e-web/wallet-flow.cjs && node e2e-web/features-flow.cjs && node e2e-web/services-flow.cjs && node e2e-web/booking-payment-flow.cjs"
  },
  "private": true
}
