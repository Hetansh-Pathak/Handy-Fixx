# Copy to .env.local (never commit). EXPO_PUBLIC_* values are embedded in the app bundle: only
# put PUBLIC values here (Supabase URL + anon/publishable key, Google WEB client id).
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>
# OAuth "Web application" client id from Google Cloud (used to obtain the id token for Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
# Show the native-check screens in non-dev builds too (development client builds are fine without it)
EXPO_PUBLIC_ENABLE_SPIKE=1
# Set to 1 only after the pricing migration (supabase/proposals/…pdf_pricing_model) is applied.
# Without it, production builds keep the "Confirm booking" button disabled.
EXPO_PUBLIC_PDF_PRICING_LIVE=0
# Set to 1 only after supabase/proposals/…booking_status_arrived is applied (or bookings.status is plain text).
# Without it the job flow skips "I've arrived" and shows "STEP x OF 3".
EXPO_PUBLIC_ARRIVED_STATUS=0
# Live map: needs a Google Maps API key at BUILD time (GOOGLE_MAPS_API_KEY, an EAS secret) and this flag at 1.
# Without them the booking screen shows ETA and distance plus an "Open in Google Maps" button.
EXPO_PUBLIC_MAPS_ENABLED=0
